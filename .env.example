# Optional settings for source builds. Copy to `.env` to use them.
# Do not add server-side secrets to this file.

# Cloud sign-in and the relay tunnel stay disabled unless these are set. aprende
# does not operate a Clerk instance or relay; point them at your own if you host one.
# APRENDE_CLERK_PUBLISHABLE_KEY=pk_test_...
# APRENDE_CLERK_JWT_TEMPLATE=relay
# APRENDE_RELAY_URL=https://relay.example.com
