{
  "name": "aprende",
  "version": "0.1.7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BernyMP/aprende",
    "directory": "apps/server"
  },
  "bin": {
    "aprende": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages --watch-path=package.json src/bin.ts",
    "dev:built": "vp run dev",
    "build:bundle": "vp pack",
    "build:exe": "node scripts/cli.ts build-exe",
    "start": "node dist/bin.mjs",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "test": "vp test run",
    "record:codex-replay": "bun scripts/record-codex-app-server-replay-fixture.ts",
    "record:claude-replay": "bun scripts/record-claude-agent-sdk-replay-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@aprende/provider-acp": "workspace:*",
    "@aprende/provider-acp-registry": "workspace:*",
    "@aprende/provider-core": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@ff-labs/fff-node": "0.11.0",
    "@napi-rs/keyring": "^1.3.0",
    "character-entities": "2.0.2",
    "diff": "8.0.3",
    "effect": "catalog:",
    "ffi-rs": "1.3.2",
    "node-pty": "^1.2.0-beta.15",
    "proper-lockfile": "4.1.2",
    "saxes": "6.0.0",
    "stream-chain": "^4.2.5",
    "stream-json": "3.6.0",
    "undici": "catalog:",
    "yaml": "catalog:",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aprende/contracts": "workspace:*",
    "@aprende/provider-testing": "workspace:*",
    "@aprende/secret-provider-core": "workspace:*",
    "@aprende/secret-provider-definitions": "workspace:*",
    "@aprende/shared": "workspace:*",
    "@aprende/tailscale": "workspace:*",
    "@aprende/web": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "^3.4.0",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
